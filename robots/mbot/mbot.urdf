<?xml version="1.0" ?>
<!-- MBot Omni Robot URDF for EECS 367 / AutoRob -->
<robot name="mbot_omni">
  <material name="chassis_metal">
    <color rgba="0.2 0.25 0.32 1.0"/>
  </material>
  <material name="wheel_rubber">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="lidar_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>

  <!-- Base Link / Chassis -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/omni.glb" scale="1 1 1"/>
      </geometry>
      <material name="chassis_metal"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <cylinder length="0.10" radius="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <mass value="2.5"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.012"/>
    </inertial>
  </link>

  <!-- Back Omni Wheel -->
  <link name="wheel_back">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_back_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_back"/>
    <origin rpy="0 0 3.14159265359" xyz="-0.09 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front-Right Omni Wheel -->
  <link name="wheel_front_right">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin rpy="0 0 -1.0471975512" xyz="0.045 -0.07794 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front-Left Omni Wheel -->
  <link name="wheel_front_left">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin rpy="0 0 1.0471975512" xyz="0.045 0.07794 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RPLidar Laser Scanner -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.035"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.08"/>
  </joint>

  <!-- Forward-Facing Camera -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.08 0.025"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.08 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.08 0 0.045"/>
  </joint>
</robot>
